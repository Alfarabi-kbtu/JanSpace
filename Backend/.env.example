# Скопируйте этот файл в .env и заполните своими значениями.
# Подробности по каждой переменной — в Backend/CLAUDE.md.

# --- Обязательные ---
SECRET_KEY=
DEBUG=True

POSTGRES_DB=janspace
POSTGRES_USER=janspace
POSTGRES_PASSWORD=

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# --- Опциональные (значения по умолчанию подходят для локальной разработки) ---
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
